# Database — Neon PostgreSQL (use direct connection, not pooler for unpooled)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dapurdekaka?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host.neon.tech/dapurdekaka?sslmode=require

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Auth
AUTH_SECRET=your-random-32-char-secret-here
# S7: separate key for TOTP secret encryption (falls back to AUTH_SECRET).
# Set this so rotating AUTH_SECRET does not lock out 2FA users.
TOTP_ENCRYPTION_KEY=your-random-32-char-totp-key-here
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Midtrans
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# Biteship (courier booking)
BITESHIP_API_KEY=biteship_test.your-key-here
BITESHIP_BASE_URL=https://api.biteship.com/v1
BITESHIP_WEBHOOK_SECRET=
# Optional: header name configured in the Biteship dashboard (default x-biteship-signature)
BITESHIP_WEBHOOK_HEADER=x-biteship-signature

# Google Maps (address pin picker)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Fonnte (customer WhatsApp notifications)
FONNTE_API_KEY=your-fonnte-api-key
FONNTE_DEVICE_ID=

# Shipping markup (server-only, not exposed to client)
SHIPPING_MARKUP_PERCENT=20
WAREHOUSE_ORIGIN_LAT=-6.958
WAREHOUSE_ORIGIN_LNG=107.636

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@dapurdekaka.com

# Minimax AI
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App — MUST be the public https origin in production (e.g. https://www.dapurdekaka.com).
# Production builds fail if this still points at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=62812xxxxxxxx

# Seed (dev only)
SEED_ADMIN_EMAIL=bashara@dapurdekaka.com
SEED_ADMIN_PASSWORD=your-strong-dev-password

# Cron Authentication
CRON_SECRET=your-random-cron-secret-here

# Feature flags (L4 kill list — default OFF for launch)
NEXT_PUBLIC_FLAG_INSURANCE_UI=false
NEXT_PUBLIC_FLAG_B2B_PORTAL=false
NEXT_PUBLIC_FLAG_BLOG_CMS=false
NEXT_PUBLIC_FLAG_AI_CONTENT=false
NEXT_PUBLIC_FLAG_VOUCHERS=false

# Maintenance mode (L4 circuit breaker)
MAINTENANCE_MODE=false